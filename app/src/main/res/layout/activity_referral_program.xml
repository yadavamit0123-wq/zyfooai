<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".ui.activities.ReferralProgramActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/backImg"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_4sdp"
            android:contentDescription="@string/referral_program_title"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter_semi_bold"
            android:text="@string/referral_program_title"
            android:textColor="#1A1A1A"
            android:textSize="@dimen/_15sdp" />
    </RelativeLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/referralTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabSelectedTextColor="@color/colorPrimary"
        app:tabTextColor="#888888" />

    <!-- Refer tab -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/referTabScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_24sdp">

            <!-- Hero: server banner_type image|video|none — amounts stay in headline text below -->
            <FrameLayout
                android:id="@+id/bannerContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_160sdp"
                android:background="#E8F5E9">

                <ImageView
                    android:id="@+id/ivReferralBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/referral_earn_banner" />

                <com.google.android.exoplayer2.ui.PlayerView
                    android:id="@+id/playerReferralBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:resize_mode="zoom"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <ProgressBar
                    android:id="@+id/bannerLoader"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvReferHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_14sdp"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:textColor="#1A1A1A"
                android:textSize="@dimen/_16sdp"
                tools:text="Earn ₹5 By Inviting Your Friends &amp; Family" />

            <TextView
                android:id="@+id/tvReferSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:textColor="#666666"
                android:textSize="@dimen/_11sdp"
                tools:text="Invite friends and get reward when they register." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_referral_code_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_12sdp">

                    <TextView
                        android:id="@+id/tvReferralCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_semi_bold"
                        android:textColor="#333333"
                        android:textSize="@dimen/_13sdp"
                        tools:text="ZY123456" />

                    <ImageView
                        android:id="@+id/btnCopyCode"
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:contentDescription="@string/referral_code_copied"
                        android:padding="@dimen/_4sdp"
                        android:src="@drawable/ic_content_copy" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnWhatsAppShare"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:contentDescription="@string/referral_share_whatsapp"
                    android:src="@drawable/ic_whatsapp" />

                <ImageView
                    android:id="@+id/btnSystemShare"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:contentDescription="@string/referral_share"
                    android:src="@drawable/ic_share" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWalletBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:textColor="#0B6E4F"
                android:textSize="@dimen/_11sdp"
                android:visibility="gone"
                tools:text="Wallet: ₹10"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:fontFamily="@font/inter_semi_bold"
                android:text="@string/referral_faq_heading"
                android:textColor="#1A1A1A"
                android:textSize="@dimen/_14sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFaq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_referral_faq" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- My Referrals tab -->
    <FrameLayout
        android:id="@+id/myReferralsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReferrals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_referral_user" />

        <LinearLayout
            android:id="@+id/emptyReferrals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_24sdp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/referral_empty"
                android:textColor="#888888"
                android:textSize="@dimen/_13sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorReferrals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_24sdp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReferralError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:text="@string/referral_load_error"
                android:textColor="#888888"
                android:textSize="@dimen/_13sdp" />

            <TextView
                android:id="@+id/btnRetryReferrals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/bg_download_open_btn"
                android:fontFamily="@font/inter_semi_bold"
                android:paddingHorizontal="@dimen/_20sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:text="@string/retry"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_12sdp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressReferrals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
