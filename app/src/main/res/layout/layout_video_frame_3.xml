<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/framLay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/topLay"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <com.makeramen.roundedimageview.RoundedImageView
            android:layout_marginLeft="@dimen/_5sdp"
            android:id="@+id/businesslogoImg"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:adjustViewBounds="true"
            android:background="@color/white"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_dummy_business_2"
            app:riv_border_color="#000000"
            app:riv_border_width="@dimen/_1sdp"
            app:riv_corner_radius="@dimen/_50sdp"
            app:riv_mutate_background="true" />

        <LinearLayout
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.pt.zyfooai.View.AutoResizeTextView
                android:fontFamily="@font/outfit_regular"
                android:letterSpacing="0.05"
                android:textStyle="bold"
                android:id="@+id/businessNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lines="1"
                android:text="@string/business_name"
                android:textColor="#000000"
                android:textSize="@dimen/_14ssp" />

            <com.pt.zyfooai.View.AutoResizeTextView
                android:id="@+id/businessDesTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:lines="1"
                android:text="@string/about_you"
                android:textColor="#000000"
                android:textSize="@dimen/_10ssp" />

        </LinearLayout>

        <LinearLayout
            android:gravity="right"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.pt.zyfooai.View.AutoResizeTextView
                android:id="@+id/businessNumberTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:lines="1"
                android:text="00000000"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="@dimen/_10ssp"
                android:drawableLeft="@drawable/ic_call"
                android:drawableTint="#000000"/>

            <com.pt.zyfooai.View.AutoResizeTextView
                android:id="@+id/businessWebsiteTv"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:lines="1"
                android:gravity="center"
                android:text="yourwebsite.com"
                android:textColor="#000000"
                android:textSize="@dimen/_10ssp"
                android:drawableLeft="@drawable/ic_website"
                android:drawableTint="#000000" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_above="@+id/bottomBackView"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#7A0000"/>

    <View
        android:layout_alignParentBottom="true"
        android:id="@+id/bottomBackView"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:background="#FFFFFF"/>

    <LinearLayout
        android:orientation="vertical"
        android:layout_alignBottom="@+id/bottomBackView"
        android:layout_width="match_parent"
        android:layout_height="135dp">

        <LinearLayout
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/profileLay"
                android:layout_width="@dimen/_85sdp"
                android:layout_height="match_parent">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/profileImg"
                    android:layout_width="@dimen/_85sdp"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo_dummy_personal_2"
                    app:riv_border_color="#8E0000"
                    app:riv_border_width="@dimen/_2sdp"
                    app:riv_mutate_background="true" />

            </RelativeLayout>

            <LinearLayout
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_gravity="bottom">

                <com.pt.zyfooai.View.AutoResizeTextView
                    android:id="@+id/userNameTv"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:lines="1"
                    android:text="@string/your_name"
                    android:textColor="#7A0000"
                    android:textSize="@dimen/_15ssp" />

                <com.pt.zyfooai.View.AutoResizeTextView
                    android:id="@+id/userDesTv"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:text="@string/about_you"
                    android:textColor="#000000"
                    android:textSize="@dimen/_10ssp" />

                <com.pt.zyfooai.View.AutoResizeTextView
                    android:layout_marginTop="@dimen/_3sdp"
                    android:id="@+id/businessAddressTv"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:text="@string/business_address"
                    android:textColor="#000000"
                    android:textSize="@dimen/_10ssp"
                    app:drawableLeftCompat="@drawable/location_img"
                    app:drawableTint="#000000"
                    android:drawablePadding="@dimen/_2sdp"/>

            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:paddingVertical="@dimen/_3sdp"
            android:background="#7A0000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/whatsappLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_1sdp"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ep_whatsapp_img" />

                <com.pt.zyfooai.View.AutoResizeTextView
                    android:gravity="center"
                    android:id="@+id/whatsappTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:fontFamily="@font/outfit_regular"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:text="000000000"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/facebookLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_1sdp"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ep_facebook_img" />

                <com.pt.zyfooai.View.AutoResizeTextView
                    android:gravity="center"
                    android:id="@+id/facebookTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:fontFamily="@font/outfit_regular"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:text="ZyFoo AI"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/instagramLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_1sdp"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgInstagram"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ep_instagram_img" />

                <com.pt.zyfooai.View.AutoResizeTextView
                    android:gravity="center"
                    android:id="@+id/instagramTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:fontFamily="@font/outfit_regular"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:text="ZyFoo AI"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>


</RelativeLayout>
