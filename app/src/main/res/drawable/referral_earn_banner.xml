<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#0B6E4F"
                android:startColor="#1DB954"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="28dp"
        android:left="40dp"
        android:right="40dp"
        android:top="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#E8F8EF" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#FFD54F" />
        </shape>
    </item>
</layer-list>
