<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/framLay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLay"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:background="#1B5CC9">

        <com.makeramen.roundedimageview.RoundedImageView
            android:layout_marginLeft="@dimen/_5sdp"
            android:id="@+id/businesslogoImg"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:adjustViewBounds="true"
            android:background="@color/white"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_dummy_business_2"
            app:riv_border_color="#EF8506"
            app:riv_border_width="@dimen/_2sdp"
            app:riv_corner_radius="@dimen/_50sdp"
            app:riv_mutate_background="true" />

        <LinearLayout
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.pt.zyfooai.View.AutoResizeTextView
                android:letterSpacing="0.05"
                android:textStyle="bold"
                android:id="@+id/businessNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:lines="1"
                android:text="@string/business_name"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp" />

            <com.pt.zyfooai.View.AutoResizeTextView
                android:id="@+id/businessDesTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:lines="1"
                android:text="@string/about_you"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp" />

        </LinearLayout>

        <LinearLayout
            android:gravity="right"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.pt.zyfooai.View.AutoResizeTextView
                android:id="@+id/businessNumberTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:lines="1"
                android:text="00000000"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:drawableLeft="@drawable/ic_call"
                android:drawableTint="@color/white"/>

            <com.pt.zyfooai.View.AutoResizeTextView
                android:layout_marginTop="@dimen/_3sdp"
                android:id="@+id/businessWebsiteTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:lines="1"
                android:gravity="center"
                android:text="yourwebsite.com"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:drawableLeft="@drawable/ic_website"
                android:drawableTint="@color/white" />

        </LinearLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_below="@+id/topLay"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_1sdp"
        app:cardElevation="@dimen/_15sdp"
        android:layout_margin="@dimen/_10sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/dateTv"
            android:layout_centerHorizontal="true"
            android:background="@drawable/date_bg"
            android:layout_width="55dp"
            android:layout_height="25dp"
            android:fontFamily="@font/inter_semi_bold"
            android:text="12 JUNE"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="10dp" />

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/transImg"
        android:layout_below="@+id/topLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/trans_img" />

    <View
        android:id="@+id/bottomBackView"
        android:layout_width="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_height="85dp"
        android:background="#1B5CCA"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_alignBottom="@+id/bottomBackView"
        android:layout_width="match_parent"
        android:layout_height="135dp">

        <LinearLayout
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_gravity="bottom">

            <LinearLayout
                android:layout_marginTop="@dimen/_1sdp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="vertical">

                <com.pt.zyfooai.View.AutoResizeTextView
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:id="@+id/userNameTv"
                    android:gravity="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:text="@string/your_name"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_15ssp" />

                <com.pt.zyfooai.View.AutoResizeTextView
                    android:id="@+id/userDesTv"
                    android:gravity="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:text="@string/about_you"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_10ssp" />

                <com.pt.zyfooai.View.AutoResizeTextView
                    android:layout_marginTop="@dimen/_1sdp"
                    android:id="@+id/businessAddressTv"
                    android:gravity="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:text="@string/business_address"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_10ssp"
                    app:drawableRightCompat="@drawable/location_img"
                    app:drawableTint="@color/white"
                    android:drawablePadding="@dimen/_2sdp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_gravity="left|bottom"
                android:layout_marginStart="-13dp"
                android:paddingVertical="@dimen/_3sdp"
                android:paddingLeft="@dimen/_13sdp"
                android:paddingRight="@dimen/_8sdp"
                android:background="@drawable/full_rounded_bg"
                android:backgroundTint="#F08606"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/whatsappLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_1sdp"
                    android:layout_weight="1"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/_10sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ep_whatsapp_img" />

                    <com.pt.zyfooai.View.AutoResizeTextView
                        android:gravity="center"
                        android:id="@+id/whatsappTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:fontFamily="@font/outfit_regular"
                        android:includeFontPadding="false"
                        android:lines="1"
                        android:text="000000000"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/facebookLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_1sdp"
                    android:layout_weight="1"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/_10sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ep_facebook_img" />

                    <com.pt.zyfooai.View.AutoResizeTextView
                        android:gravity="center"
                        android:id="@+id/facebookTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:fontFamily="@font/outfit_regular"
                        android:includeFontPadding="false"
                        android:lines="1"
                        android:text="ZyFoo AI"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/instagramLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_1sdp"
                    android:layout_weight="1"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgInstagram"
                        android:layout_width="@dimen/_10sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ep_instagram_img" />

                    <com.pt.zyfooai.View.AutoResizeTextView
                        android:gravity="center"
                        android:id="@+id/instagramTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:fontFamily="@font/outfit_regular"
                        android:includeFontPadding="false"
                        android:lines="1"
                        android:text="ZyFoo AI"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/profileLay"
            android:layout_marginEnd="@dimen/_3sdp"
            android:layout_width="@dimen/_95sdp"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:src="@drawable/logo_border_img" />

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/profileImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:background="@color/white"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_dummy_personal_2"
                android:layout_margin="@dimen/_5sdp"
                app:riv_border_color="@color/white"
                app:riv_border_width="@dimen/_2sdp"
                app:riv_corner_radius="@dimen/_50sdp"
                app:riv_mutate_background="true" />

        </RelativeLayout>

    </LinearLayout>


</RelativeLayout>
