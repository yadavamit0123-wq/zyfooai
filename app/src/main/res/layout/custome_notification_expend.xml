<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/mainLay"
    android:background="@drawable/rounded_bg"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginVertical="@dimen/_5sdp"
        android:id="@+id/icon_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:background="@drawable/ic_circle"
            android:backgroundTint="@color/white"
            android:id="@+id/profilePic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:paddingBottom="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"/>

        <LinearLayout
            android:id="@+id/notification_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/icon_container"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="6dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="@dimen/_8sdp"
                android:textColor="@color/white"
                android:text="@string/app_name"/>

            <TextView
                android:id="@+id/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="@dimen/_10sdp"
                android:text="Expand me to see a detailed message!"/>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_200sdp">

            <ImageView
                android:background="@color/black"
                android:layout_above="@id/frameLay"
                android:layout_centerHorizontal="true"
                android:id="@+id/iv"
                android:scaleType="centerCrop"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:src="@drawable/logo"/>

            <LinearLayout
                android:id="@+id/frameLay"
                android:background="@color/white"
                android:paddingLeft="@dimen/_5sdp"
                android:layout_above="@+id/shareImg"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <TextView
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Hello Android! "
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#042B05"
                    android:fontFamily="@font/inter_bold"/>


            </LinearLayout>

            <RelativeLayout
                android:layout_above="@id/shareImg"
                android:layout_centerHorizontal="true"
                android:id="@+id/imgLay"
                android:background="@drawable/ic_circle"
                android:backgroundTint="@color/white"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_20sdp">

                <ImageView
                    android:id="@+id/profilePic2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/shareImg"
                android:padding="3sp"
                android:gravity="center"
                android:background="#1B9C04"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:padding="@dimen/_3sdp"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_whatsapp"
                    app:tint="@color/white" />

                <TextView
                    android:layout_marginLeft="@dimen/_6sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</LinearLayout>