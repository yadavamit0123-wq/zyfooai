<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:soundEffectsEnabled="true">

    <data>

        <variable
            name="posts"
            type="com.pt.zyfooai.model.PostItem" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/al_gray"
        android:gravity="center"
        android:orientation="vertical">


        <RelativeLayout
            android:layout_above="@+id/swipeFrames"
            android:id="@+id/relativeLayout4"
            android:layout_alignParentTop="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/feed_card_margin"
                app:cardCornerRadius="@dimen/_5sdp">

                <RelativeLayout
                    android:id="@+id/mainLayOut"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/media_blur_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/image_post"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/btxt0" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="0dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/layout_frame_sticker_1" />

                    <RelativeLayout
                        android:id="@+id/watermarkLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignEnd="@id/image_post"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="5dp">

                        <ImageView
                            android:id="@+id/iv_watermark"
                            android:layout_width="@dimen/_90sdp"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:alpha="0.5"
                            android:src="@drawable/watermark" />

                        <ImageView
                            android:id="@+id/removeWatermark"
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:layout_alignParentStart="true"
                            android:src="@drawable/remove"
                            />
                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/btnReportMenu"
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@drawable/bg_report_menu_btn"
                        android:contentDescription="@string/report_content_title"
                        android:elevation="6dp"
                        android:padding="@dimen/_4sdp"
                        android:src="@drawable/ic_more_vert_white" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </RelativeLayout>

        <LinearLayout
            android:layout_alignParentBottom="true"
            android:id="@+id/swipeFrames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/feed_footer_min_height"
            android:paddingHorizontal="@dimen/feed_footer_padding_h"
            android:paddingVertical="@dimen/feed_footer_padding_v"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/swipeFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="@dimen/_22sdp">

                <LinearLayout
                    android:id="@+id/customizeFrameBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ripple_round"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_4sdp"
                    android:paddingVertical="0dp">

                    <ImageView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:src="@drawable/ic_edit_"
                        app:tint="@color/g3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:fontFamily="@font/inter_semi_bold"
                        android:text="@string/customize_frame"
                        android:textColor="@color/g3"
                        android:textSize="@dimen/_8sdp" />
                </LinearLayout>

                <ru.tinkoff.scrollingpagerindicator.ScrollingPagerIndicator
                    android:id="@+id/indicator"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    app:spi_dotColor="#AFB1B5"
                    app:spi_dotSelectedColor="@color/g3"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_gravity="center"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/ic_swipframe_icon"
                    app:tint="@color/black" />

                <TextView
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:fontFamily="@font/inter_semi_bold"
                    android:gravity="left"
                    android:text="Swipe frames"
                    android:textColor="@color/post_meta_text_secondary"
                    android:textSize="@dimen/_8sdp" />

                <LinearLayout
                    android:id="@+id/musicBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="@drawable/gradintround_shape"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_1sdp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:layout_gravity="center"
                        android:padding="@dimen/_2sdp"
                        android:src="@drawable/ic_music"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:text="Music"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_7sdp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="0dp">

                <!-- Kept for binding compatibility; hidden from UI -->
                <LinearLayout
                    android:id="@+id/edit_Btn"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDownloadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:fontFamily="@font/inter_bold"
                    android:maxLines="1"
                    android:minWidth="@dimen/_22sdp"
                    android:gravity="center"
                    android:text="0+"
                    android:textColor="@color/g3"
                    android:textSize="@dimen/_9sdp" />

                <LinearLayout
                    android:id="@+id/downloadBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/feed_footer_btn_height"
                    android:layout_weight="1"
                    android:background="@drawable/gradintround_shape"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_6sdp">

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:padding="@dimen/_1sdp"
                        android:src="@drawable/ic_download_regular_color"
                        app:tint="@color/white" />

                    <com.pt.zyfooai.View.AutoResizeTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:fontFamily="@font/inter_bold"
                        android:maxLines="1"
                        android:text="Download"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9sdp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aiBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    android:layout_weight="1.15"
                    android:background="@drawable/bg_ai_btn_3d"
                    android:elevation="@dimen/_6sdp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:translationZ="@dimen/_4sdp">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_ai_spark"
                        app:tint="@color/white" />

                    <com.pt.zyfooai.View.AutoResizeTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:fontFamily="@font/inter_bold"
                        android:maxLines="1"
                        android:text="@string/ai_button_label"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11sdp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shareBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/feed_footer_btn_height"
                    android:layout_weight="1"
                    android:background="@drawable/gradintround_shape_two"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_6sdp">

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:padding="@dimen/_1sdp"
                        android:src="@drawable/ic_whatsapp"
                        app:tint="@color/white" />

                    <com.pt.zyfooai.View.AutoResizeTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:fontFamily="@font/inter_bold"
                        android:maxLines="1"
                        android:text="Share"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9sdp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvShareCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:fontFamily="@font/inter_bold"
                    android:maxLines="1"
                    android:minWidth="@dimen/_22sdp"
                    android:gravity="center"
                    android:text="0+"
                    android:textColor="@color/g3"
                    android:textSize="@dimen/_9sdp" />
            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>

</layout>