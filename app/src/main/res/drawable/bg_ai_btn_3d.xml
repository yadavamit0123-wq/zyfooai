<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft depth shadow -->
    <item
        android:left="1dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- Main 3D gradient body -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:endColor="#FF2BB673"
                android:startColor="#FF0B5C4A"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
    <!-- Top highlight gloss -->
    <item
        android:bottom="14dp"
        android:left="4dp"
        android:right="4dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#55FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
