<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:background="@drawable/rzp_border_bottom"
        android:padding="@dimen/_10sdp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/circle_drawable"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:src="@drawable/ic_music"
            android:scaleType="centerCrop"
            app:tint="@color/white" />
        <LinearLayout
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/titleTv"
                android:layout_marginLeft="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/_15sdp"
                android:textColor="#000000"
                android:maxLines="1"
                android:ellipsize="end"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/play_btn"
                    android:layout_margin="@dimen/_3sdp"
                    android:background="@drawable/btn_grediant"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_25sdp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:text="Play"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingVertical="0dp"
                    android:paddingLeft="@dimen/_10sdp"
                    app:icon="@drawable/exo_icon_play"
                    app:iconSize="@dimen/_16sdp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selec_btn"
                    android:layout_margin="@dimen/_3sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_25sdp"
                    android:background="@drawable/btn_grediant"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:text="@string/select"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingVertical="0dp"
                    android:paddingLeft="@dimen/_10sdp"
                    app:icon="@drawable/ic_arrow_circle_right"
                    app:iconSize="@dimen/_16sdp"/>

            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:layout_margin="@dimen/_5sdp"
            android:id="@+id/premium_tag"
            android:layout_gravity="right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_premium" />

        </RelativeLayout>

    </LinearLayout>
</layout>
